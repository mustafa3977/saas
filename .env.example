# Server Environment Variables
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173
MONGODB_URI=mongodb://lp_admin:lp_secret_password@localhost:27017/legacypixels?authSource=admin
REDIS_URL=redis://localhost:6379

# Authentication & Security
JWT_ACCESS_SECRET=your_jwt_access_secret_key_minimum_32_characters_long
JWT_REFRESH_SECRET=your_jwt_refresh_secret_key_minimum_32_characters_long
COOKIE_SECRET=your_cookie_signing_secret_key
SESSION_SECRET=your_session_secret_key

# Stripe
STRIPE_SECRET_KEY=sk_test_placeholder_key
STRIPE_WEBHOOK_SECRET=whsec_placeholder_secret
VITE_STRIPE_PUBLISHABLE_KEY=pk_test_placeholder_key

# S3 / Cloudflare R2 Storage
S3_ENDPOINT=https://your-account-id.r2.cloudflarestorage.com
S3_REGION=auto
S3_BUCKET=legacypixels-files
S3_ACCESS_KEY_ID=your_access_key
S3_SECRET_ACCESS_KEY=your_secret_key

# Transactional Email (Resend)
RESEND_API_KEY=re_placeholder_key
EMAIL_FROM="Legacy Pixels <hello@legacypixels.net>"
EMAIL_REPLY_TO=support@legacypixels.net

# Client Environment Variables
VITE_API_URL=http://localhost:5000/api
